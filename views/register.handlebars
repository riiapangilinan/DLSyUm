<main>
    <section id="register-section">
        <div class="form-container">
            <h2>Sign Up</h2>
            <form id="register-form">
                <input type="text" id="username" placeholder="Username" required>
                <input type="password" id="password" placeholder="Password" required>
                <input type="password" id="confirm-password" placeholder="Confirm Password" required>
                <input type="file" id="profile-picture" placeholder="Profile Picture" name="profile-picture" required>
                <textarea id="description" placeholder="Description" required></textarea>
                <label for="restaurant" class="restaurant-label">Register as Restaurant Account</label>
                <input type="checkbox" id="restaurant">
                <button type="submit">Register</button>
            </form>
        </div>
    </section>
</main>
