<main>
    <section id="login-form">
        <div class="form-container">
            <h2>Recover Password</h2>
            <form id="login-form">
                <input type="text" id="username" placeholder="Username" required>
                <select id="description" required>
                    <option value="" disabled selected>Select your description</option>
                </select>
                <input type="password" id="password" placeholder="Password" style="display: none;" required>
                <input type="password" id="confirm-password" placeholder="Confirm Password" style="display: none;" required>
                <button type="submit">Recover</button>                   
            </form>
        </div>
    </section>
</main>
